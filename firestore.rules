rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Global Hardened Primitives ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidShareCode(code) {
      return code is string && code.size() >= 6 && code.size() <= 16 && code.matches('^[A-Z0-9\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        ('email' in request.auth.token &&
         request.auth.token.email == 'kamleshkumarsingh317@gmail.com' &&
         request.auth.token.email_verified == true)
      );
    }

    function isBoundedStringList(arr, maxLen) {
      return arr is list && arr.size() <= maxLen;
    }

    // --- Validation Helpers ---
    function isValidUserProfile(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 80 &&
             (!('email' in data) || (data.email is string && data.email.size() <= 120)) &&
             (!('clubName' in data) || (data.clubName is string && data.clubName.size() <= 80)) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidLiveMatchCore(data) {
      return data.adminId is string && data.adminId.size() > 0 && data.adminId.size() <= 128 &&
             data.adminName is string && data.adminName.size() > 0 && data.adminName.size() <= 80 &&
             data.localMatchId is int && data.localMatchId >= 0 &&
             data.hostTeam is string && data.hostTeam.size() > 0 && data.hostTeam.size() <= 60 &&
             data.visitorTeam is string && data.visitorTeam.size() > 0 && data.visitorTeam.size() <= 60 &&
             data.tossSummary is string && data.tossSummary.size() <= 140 &&
             data.matchStatus in ['LIVE', 'INNINGS_BREAK', 'COMPLETED'] &&
             data.sharingEnabled is bool &&
             data.totalOvers is int && data.totalOvers >= 1 && data.totalOvers <= 99 &&
             data.currentInningsNumber is int && data.currentInningsNumber >= 1 && data.currentInningsNumber <= 2 &&
             data.battingTeam is string && data.battingTeam.size() > 0 && data.battingTeam.size() <= 60 &&
             data.bowlingTeam is string && data.bowlingTeam.size() > 0 && data.bowlingTeam.size() <= 60 &&
             data.ballSequence is int && data.ballSequence >= 0 && data.ballSequence <= 100000 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidLiveMatchStats(data) {
      return data.scoreRuns is int && data.scoreRuns >= 0 && data.scoreRuns <= 5000 &&
             data.scoreWickets is int && data.scoreWickets >= 0 && data.scoreWickets <= 20 &&
             data.oversDisplay is string && data.oversDisplay.size() > 0 && data.oversDisplay.size() <= 16 &&
             data.crr is string && data.crr.size() > 0 && data.crr.size() <= 16 &&
             data.rrr is string &&
             data.targetRuns is int && data.targetRuns >= 0 && data.targetRuns <= 5000 &&
             data.chaseSummary is string &&
             data.resultSummary is string &&
             data.strikerName is string &&
             data.strikerStats is string &&
             data.nonStrikerName is string &&
             data.nonStrikerStats is string &&
             data.bowlerName is string &&
             data.bowlerStats is string &&
             data.partnershipSummary is string &&
             data.lastWicketSummary is string &&
             data.lastBallBadge is string &&
             data.lastShotZone is string &&
             isBoundedStringList(data.currentOverBalls, 24) &&
             isBoundedStringList(data.recentBalls, 24);
    }

    function isValidLiveMatchScorecard(data) {
      return data.innings1Summary is string &&
             data.innings2Summary is string &&
             isBoundedStringList(data.battingCardLines, 20) &&
             isBoundedStringList(data.bowlingCardLines, 20) &&
             (!('potmSummary' in data) || (data.potmSummary is string && data.potmSummary.size() <= 140)) &&
             (!('innings1Meta' in data) || (data.innings1Meta is string && data.innings1Meta.size() <= 160)) &&
             (!('innings2Meta' in data) || (data.innings2Meta is string && data.innings2Meta.size() <= 160)) &&
             (!('innings1Extras' in data) || (data.innings1Extras is string && data.innings1Extras.size() <= 80)) &&
             (!('innings2Extras' in data) || (data.innings2Extras is string && data.innings2Extras.size() <= 80)) &&
             (!('innings1BattingLines' in data) || isBoundedStringList(data.innings1BattingLines, 20)) &&
             (!('innings1BowlingLines' in data) || isBoundedStringList(data.innings1BowlingLines, 20)) &&
             (!('innings1FowLines' in data) || isBoundedStringList(data.innings1FowLines, 20)) &&
             (!('innings1PartnershipLines' in data) || isBoundedStringList(data.innings1PartnershipLines, 20)) &&
             (!('innings2BattingLines' in data) || isBoundedStringList(data.innings2BattingLines, 20)) &&
             (!('innings2BowlingLines' in data) || isBoundedStringList(data.innings2BowlingLines, 20)) &&
             (!('innings2FowLines' in data) || isBoundedStringList(data.innings2FowLines, 20)) &&
             (!('innings2PartnershipLines' in data) || isBoundedStringList(data.innings2PartnershipLines, 20)) &&
             (!('hostTeamPhoto' in data) || (data.hostTeamPhoto is string && data.hostTeamPhoto.size() <= 32000)) &&
             (!('visitorTeamPhoto' in data) || (data.visitorTeamPhoto is string && data.visitorTeamPhoto.size() <= 32000)) &&
             (!('analyticsLines' in data) || isBoundedStringList(data.analyticsLines, 600));
    }

    function isValidLiveMatch(data) {
      return isValidLiveMatchCore(data) &&
             isValidLiveMatchStats(data) &&
             isValidLiveMatchScorecard(data);
    }

    function isValidPlayerCareer(data) {
      return data.adminId is string && data.adminId.size() > 0 && data.adminId.size() <= 128 &&
             data.shareCode is string && data.shareCode.size() >= 6 && data.shareCode.size() <= 16 &&
             data.playerName is string && data.playerName.size() > 0 && data.playerName.size() <= 80 &&
             (!('teamName' in data) || (data.teamName is string && data.teamName.size() <= 80)) &&
             (!('role' in data) || (data.role is string && data.role.size() <= 40)) &&
             (!('photoBase64' in data) || (data.photoBase64 is string && data.photoBase64.size() <= 32000)) &&
             data.matchesPlayed is int && data.matchesPlayed >= 0 && data.matchesPlayed <= 10000 &&
             (!('battingStatsLine' in data) || (data.battingStatsLine is string && data.battingStatsLine.size() <= 120)) &&
             (!('bowlingStatsLine' in data) || (data.bowlingStatsLine is string && data.bowlingStatsLine.size() <= 120)) &&
             (!('recentPerformancesLines' in data) || isBoundedStringList(data.recentPerformancesLines, 30)) &&
             (!('careerShotLines' in data) || isBoundedStringList(data.careerShotLines, 150)) &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    // --- Collection 1: Private Admin / User Profiles (Strict PII Isolation) ---
    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
      allow list: if false;

      allow create: if isSignedIn() &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       incoming().userId == request.auth.uid &&
                       incoming().keys().hasAll(['userId', 'displayName', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'displayName', 'email', 'clubName', 'createdAt', 'updatedAt']) &&
                       isValidUserProfile(incoming());

      allow update: if isSignedIn() &&
                       isValidId(userId) &&
                       isValidUserProfile(incoming()) &&
                       request.auth.uid == userId &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'email', 'clubName', 'updatedAt']);

      allow delete: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;

      match /avatars/{avatarId} {
        allow get, list: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;

        allow create, update: if isSignedIn() &&
                                 isValidId(userId) &&
                                 isValidId(avatarId) &&
                                 request.auth.uid == userId &&
                                 request.resource.data.keys().hasOnly(['ownerUid', 'entityType', 'entityName', 'teamName', 'photoBase64', 'updatedAt']) &&
                                 request.resource.data.ownerUid == request.auth.uid &&
                                 request.resource.data.entityType in ['TEAM', 'PLAYER'] &&
                                 request.resource.data.entityName is string &&
                                 request.resource.data.entityName.size() > 0 &&
                                 request.resource.data.entityName.size() <= 80 &&
                                 request.resource.data.get('teamName', '') is string &&
                                 request.resource.data.get('teamName', '').size() <= 80 &&
                                 request.resource.data.photoBase64 is string &&
                                 request.resource.data.photoBase64.size() <= 32000 &&
                                 request.resource.data.updatedAt is timestamp &&
                                 request.resource.data.updatedAt <= request.time;

        allow delete: if isSignedIn() && isValidId(userId) && isValidId(avatarId) && request.auth.uid == userId;
      }

      match /saved_teams/{teamId} {
        allow get, list: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;

        allow create, update: if isSignedIn() &&
                                 isValidId(userId) &&
                                 isValidId(teamId) &&
                                 request.auth.uid == userId &&
                                 request.resource.data.keys().hasOnly([
                                   'ownerUid', 'teamName', 'shortCode', 'photoBase64', 'playerEntries', 'updatedAt'
                                 ]) &&
                                 request.resource.data.ownerUid == request.auth.uid &&
                                 request.resource.data.teamName is string &&
                                 request.resource.data.teamName.size() > 0 &&
                                 request.resource.data.teamName.size() <= 80 &&
                                 request.resource.data.get('shortCode', '') is string &&
                                 request.resource.data.get('shortCode', '').size() <= 8 &&
                                 request.resource.data.get('photoBase64', '') is string &&
                                 request.resource.data.get('photoBase64', '').size() <= 32000 &&
                                 isBoundedStringList(request.resource.data.get('playerEntries', []), 60) &&
                                 request.resource.data.updatedAt is timestamp &&
                                 request.resource.data.updatedAt <= request.time;

        allow delete: if isSignedIn() && isValidId(userId) && isValidId(teamId) && request.auth.uid == userId;
      }
    }

    // --- Collection 2: Real-Time Shared Live Matches ---
    match /live_matches/{shareCode} {
      // Spectators (even without logging in) can read any live match with sharingEnabled == true;
      // missing codes (resource == null) cleanly return not-found; match admin or super-admin can always read.
      allow get: if isValidShareCode(shareCode) && (
                    resource == null ||
                    resource.data.sharingEnabled == true ||
                    (isSignedIn() && (resource.data.adminId == request.auth.uid || isAdmin()))
                  );

      // Spectators without login can list active shared matches (where sharingEnabled == true);
      // signed-in Admins can also list all of their own broadcasts (including paused ones).
      allow list: if resource.data.sharingEnabled == true ||
                     (isSignedIn() && (resource.data.adminId == request.auth.uid || isAdmin()));

      allow create: if isEmailVerified() &&
                       isValidShareCode(shareCode) &&
                       request.resource.data.adminId == request.auth.uid &&
                       request.resource.data.keys().hasOnly([
                         'adminId', 'adminName', 'localMatchId', 'hostTeam', 'visitorTeam',
                         'tossSummary', 'matchStatus', 'sharingEnabled', 'totalOvers',
                         'currentInningsNumber', 'battingTeam', 'bowlingTeam', 'scoreRuns',
                         'scoreWickets', 'oversDisplay', 'crr', 'rrr', 'targetRuns',
                         'chaseSummary', 'resultSummary', 'strikerName', 'strikerStats',
                         'nonStrikerName', 'nonStrikerStats', 'bowlerName', 'bowlerStats',
                         'partnershipSummary', 'lastWicketSummary', 'lastBallBadge',
                         'lastShotZone', 'currentOverBalls', 'recentBalls', 'innings1Summary',
                         'innings2Summary', 'battingCardLines', 'bowlingCardLines',
                         'potmSummary', 'innings1Meta', 'innings2Meta', 'innings1Extras',
                         'innings2Extras', 'innings1BattingLines', 'innings1BowlingLines',
                         'innings1FowLines', 'innings1PartnershipLines', 'innings2BattingLines',
                         'innings2BowlingLines', 'innings2FowLines', 'innings2PartnershipLines',
                         'hostTeamPhoto', 'visitorTeamPhoto', 'analyticsLines',
                         'ballSequence', 'createdAt', 'updatedAt'
                       ]) &&
                       isValidLiveMatch(request.resource.data);

      allow update: if isSignedIn() &&
                       isValidShareCode(shareCode) &&
                       request.resource.data.adminId == resource.data.adminId &&
                       request.resource.data.localMatchId == resource.data.localMatchId &&
                       request.resource.data.createdAt == resource.data.createdAt && (
                         // Action 1 or Super-admin override: validate payload once after auth check
                         ((
                           (isEmailVerified() &&
                            resource.data.adminId == request.auth.uid &&
                            resource.data.matchStatus != 'COMPLETED' &&
                            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
                              'adminName', 'hostTeam', 'visitorTeam', 'tossSummary',
                              'matchStatus', 'sharingEnabled', 'totalOvers',
                              'currentInningsNumber', 'battingTeam', 'bowlingTeam',
                              'scoreRuns', 'scoreWickets', 'oversDisplay', 'crr', 'rrr',
                              'targetRuns', 'chaseSummary', 'resultSummary',
                              'strikerName', 'strikerStats', 'nonStrikerName',
                              'nonStrikerStats', 'bowlerName', 'bowlerStats',
                              'partnershipSummary', 'lastWicketSummary', 'lastBallBadge',
                              'lastShotZone', 'currentOverBalls', 'recentBalls',
                              'innings1Summary', 'innings2Summary', 'battingCardLines',
                              'bowlingCardLines', 'potmSummary', 'innings1Meta', 'innings2Meta',
                              'innings1Extras', 'innings2Extras', 'innings1BattingLines',
                              'innings1BowlingLines', 'innings1FowLines', 'innings1PartnershipLines',
                              'innings2BattingLines', 'innings2BowlingLines', 'innings2FowLines',
                              'innings2PartnershipLines', 'hostTeamPhoto', 'visitorTeamPhoto',
                              'analyticsLines', 'ballSequence', 'updatedAt'
                            ])) ||
                           isAdmin()
                          ) && isValidLiveMatch(request.resource.data)) ||
                         // Action 2: Match admin toggles sharingEnabled even after match completion
                         (resource.data.adminId == request.auth.uid &&
                          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sharingEnabled', 'updatedAt']) &&
                          request.resource.data.sharingEnabled is bool &&
                          request.resource.data.updatedAt is timestamp &&
                          request.resource.data.updatedAt <= request.time)
                       );

      allow delete: if isSignedIn() &&
                       isValidShareCode(shareCode) &&
                       (resource.data.adminId == request.auth.uid || isAdmin());

      match /player_careers/{playerKey} {
        allow get: if isValidShareCode(shareCode) && isValidId(playerKey) && (
                      get(/databases/$(database)/documents/live_matches/$(shareCode)).data.sharingEnabled == true ||
                      (isSignedIn() && (
                        get(/databases/$(database)/documents/live_matches/$(shareCode)).data.adminId == request.auth.uid ||
                        isAdmin()
                      ))
                    );

        allow list: if isValidShareCode(shareCode) && (
                       get(/databases/$(database)/documents/live_matches/$(shareCode)).data.sharingEnabled == true ||
                       (isSignedIn() && (
                         get(/databases/$(database)/documents/live_matches/$(shareCode)).data.adminId == request.auth.uid ||
                         isAdmin()
                       ))
                     );

        allow create, update: if isEmailVerified() &&
                                 isValidShareCode(shareCode) &&
                                 isValidId(playerKey) &&
                                 request.resource.data.adminId == request.auth.uid &&
                                 request.resource.data.shareCode == shareCode &&
                                 get(/databases/$(database)/documents/live_matches/$(shareCode)).data.adminId == request.auth.uid &&
                                 request.resource.data.keys().hasOnly([
                                   'adminId', 'shareCode', 'playerName', 'teamName', 'role',
                                   'photoBase64', 'matchesPlayed', 'battingStatsLine',
                                   'bowlingStatsLine', 'recentPerformancesLines',
                                   'careerShotLines', 'updatedAt'
                                 ]) &&
                                 isValidPlayerCareer(request.resource.data);

        allow delete: if isSignedIn() &&
                         isValidShareCode(shareCode) &&
                         isValidId(playerKey) &&
                         (get(/databases/$(database)/documents/live_matches/$(shareCode)).data.adminId == request.auth.uid || isAdmin());
      }
    }

    // --- Collection 3: Server-managed Admin Registry ---
    match /admins/{adminUid} {
      allow read, write: if false;
    }

    // --- Collection 4: App Config & In-App Update Version Info ---
    match /app_config/{docId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
